# Copy to .env and fill in real values. NEVER commit .env.
# Postgres connection string.
#
# LOCAL: use the raw TCP url from `pnpm exec prisma dev ls`, with ONLY
# `?sslmode=disable` kept — e.g.
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Do NOT use the `prisma+postgres://...?api_key=` url that command prints first:
# the Prisma CLI accepts it, but lib/db.ts's pg-based driver adapter cannot, so
# the CLI works while the app fails to connect. Do not keep the pool parameters
# on the TCP url either — the CLI rejects them with P1013.
#
# CLOUD (Neon or Supabase):
# Neon:     postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Supabase: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/app?schema=public"

# Leave empty for the LOCAL `prisma dev` server — it carries its own shadow
# database inside its connection string, so this is unused there. Required for
# Neon (a real shadow-db URL) once you point DATABASE_URL at it: `prisma migrate`
# rejects a literal empty string (P1013), which is why prisma.config.ts coerces
# "" to undefined rather than passing it through.
SHADOW_DATABASE_URL=""

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js (magic-link sign-in, ADR-0002) ---
# Generate with: pnpm dlx auth secret
AUTH_SECRET="replace-with-output-of-pnpm-dlx-auth-secret"
# Base URL Auth.js uses for callbacks. Matches NEXT_PUBLIC_APP_URL in dev.
AUTH_URL="http://localhost:3000"

# --- Resend (magic-link, direct-notice, and consent-confirmation emails) ---
# API key from https://resend.com — server only.
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sending address/domain in Resend.
EMAIL_FROM="tutor@example.com"
# Set to "console" for local development/CI: logs recipient + subject only
# (never the message body — the magic-link and consent-confirmation emails
# both carry a live token URL in their body) and reports `delivered: false`
# (lib/email/client.ts) so nothing downstream mistakes a log line for real
# delivery. Leave unset/anything else in production to send via Resend.
EMAIL_TRANSPORT="console"

# --- Vercel Blob (private student-upload storage, ADR-0003) ---
# From `vercel env pull` or the Vercel Blob dashboard — server only.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# --- Anthropic (worksheet extraction, ADR-0005) ---
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Vercel Cron (authenticates GET /api/cron/* routes) ---
# Any long random string; Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET="replace-with-a-long-random-string"

# --- Parental consent method (ADR-0008) ---
# Must be a value lib/consent/methods/registry.ts implements. Only EMAIL_PLUS
# ships in M0/M1.
CONSENT_METHOD="EMAIL_PLUS"
# HMAC-SHA256 key used to pseudonymise the adult's identity in
# ConsentAuditArtifact — never the raw email. Any long random string.
AUDIT_PSEUDONYM_KEY="replace-with-a-long-random-string"

# For deployment, the Neon connection string lives in .env.neon (gitignored),
# NOT here. See docs/runbook.md.
