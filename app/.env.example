# Copy to .env and fill in real values. NEVER commit .env.
# Postgres connection string.
#
# LOCAL: use the raw TCP url from `pnpm exec prisma dev ls`, with ONLY
# `?sslmode=disable` kept — e.g.
#   postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Do NOT use the `prisma+postgres://...?api_key=` url that command prints first:
# the Prisma CLI accepts it, but lib/db.ts's pg-based driver adapter cannot, so
# the CLI works while the app fails to connect. Do not keep the pool parameters
# on the TCP url either — the CLI rejects them with P1013.
#
# CLOUD (Neon or Supabase):
# Neon:     postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Supabase: postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/app?schema=public"

# Leave empty for Neon/Supabase's own shadow-db support, or when you don't
# need `prisma migrate dev`'s shadow-diffing at all (`db execute` + `migrate
# resolve`, the same "baseline an existing database" flow `db:migrate:prod`
# uses, never touches a shadow db). `prisma migrate` rejects a literal empty
# string (P1013), which is why prisma.config.ts coerces "" to undefined
# rather than passing it through.
#
# FINDING (M2 migration): the LOCAL `prisma dev` server's advertised shadow
# database (port 51215 in `pnpm exec prisma dev ls`'s output) is NOT reliably
# clean — once anything is applied directly to the main TCP port (51214),
# `prisma migrate dev` can misreport drift against history that WAS actually
# recorded (this repo's `_prisma_migrations` writes were observed to be
# eventually-consistent, not immediately durable, against this specific local
# server) and then offer to reset the "public" schema — i.e. drop all local
# dev data. Do not accept that prompt. If you hit it, use the non-interactive,
# non-destructive path instead (this is what applied the M2 migration):
#   1. `pnpm exec prisma migrate diff --from-migrations prisma/migrations
#        --to-schema prisma/schema.prisma --script` with
#        `SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"`
#        set inline (never written here) — computes ONLY the new SQL.
#   2. Save it as `prisma/migrations/<timestamp>_<name>/migration.sql`.
#   3. `pnpm exec prisma db execute --file <that file>` — applies it directly.
#   4. `pnpm exec prisma migrate resolve --applied <timestamp>_<name>` —
#      records it in history; re-run once if `migrate status` doesn't show it
#      immediately (same eventual-consistency finding above).
SHADOW_DATABASE_URL=""

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js (magic-link sign-in, ADR-0002) ---
# Generate with: pnpm dlx auth secret
AUTH_SECRET="replace-with-output-of-pnpm-dlx-auth-secret"
# Base URL Auth.js uses for callbacks. Matches NEXT_PUBLIC_APP_URL in dev.
AUTH_URL="http://localhost:3000"

# --- Resend (magic-link, direct-notice, and consent-confirmation emails) ---
# API key from https://resend.com — server only.
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sending address/domain in Resend.
EMAIL_FROM="tutor@example.com"
# Set to "console" for local development/CI: logs recipient + subject only
# (never the message body — the magic-link and consent-confirmation emails
# both carry a live token URL in their body) and reports `delivered: false`
# (lib/email/client.ts) so nothing downstream mistakes a log line for real
# delivery. Leave unset/anything else in production to send via Resend.
EMAIL_TRANSPORT="console"

# --- Storage driver (ADR-0003) ---
# "local" (default) uses lib/storage/local-fs.ts, a filesystem adapter under
# .storage/ (gitignored) — no Vercel account needed. Set to "vercel-blob"
# once lib/storage/vercel-blob.ts (B15) is built; until then that value
# fails loudly rather than silently doing nothing.
STORAGE_DRIVER="local"

# --- Vercel Blob (private student-upload storage, ADR-0003) ---
# Only read once STORAGE_DRIVER="vercel-blob". From `vercel env pull` or the
# Vercel Blob dashboard — server only.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx"

# --- Anthropic (worksheet extraction, ADR-0005) ---
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OPTIONAL. Required ONLY when the key above is an identity-linked key — those
# are rejected with a 400 (not a 401) reading "anthropic-workspace-id is
# required when authenticating with an identity-linked API key". Found in the
# Anthropic Console under Settings -> Workspaces. Leave unset for a classic
# workspace-scoped key: lib/ai/client.ts omits the header entirely when empty.
# Not a secret in the way the key is, but it lives here so all API config is
# in one place.
ANTHROPIC_WORKSPACE_ID=""

# --- Vercel Cron (authenticates GET /api/cron/* routes) ---
# Any long random string; Vercel Cron sends it as `Authorization: Bearer <value>`.
CRON_SECRET="replace-with-a-long-random-string"

# --- Parental consent method (ADR-0008) ---
# Must be a value lib/consent/methods/registry.ts implements. Only EMAIL_PLUS
# ships in M0/M1.
CONSENT_METHOD="EMAIL_PLUS"
# HMAC-SHA256 key used to pseudonymise the adult's identity in
# ConsentAuditArtifact — never the raw email. Any long random string.
AUDIT_PSEUDONYM_KEY="replace-with-a-long-random-string"

# For deployment, the Neon connection string lives in .env.neon (gitignored),
# NOT here. See docs/runbook.md.
